# =============================================================================
# .gitignore (racine) — Projet Cartographie IMF DRS-SFD
# Exclut les fichiers générés, les secrets, les données réelles et les artefacts de build.
# Fichier unique du dépôt : les motifs « .env* » protègent aussi config/.env et
# config/.env.production.
# =============================================================================

# --- Environnements virtuels Python ---
backend/.venv/
backend/venv/
backend/env/
*.pyc
__pycache__/
*.pyo
*.pyd
.Python

# --- Variables d'environnement (SECRETS — ne jamais versionner) ---
.env
.env*
!.env.example
**/.env*
!**/.env.example
.env.local
.env.*.local
backend/.env
frontend/.env
frontend/.env.local
frontend/.env.production

# --- Django ---
backend/staticfiles/
backend/mediafiles/
backend/*.log
backend/db.sqlite3

# --- Node.js / Frontend ---
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.vite/

# --- Éditeurs et IDE ---
.continue/
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Tests et couverture ---
.pytest_cache/
backend/.coverage
backend/htmlcov/
frontend/coverage/

# --- Outils de qualité ---
backend/.mypy_cache/
backend/.ruff_cache/
frontend/.eslintcache

# --- Logs ---
*.log
logs/

# --- Fichiers temporaires ---
*.tmp
*.bak
*.tsbuildinfo

# --- Déploiement (outils en ligne de commande) ---
.vercel/

# Données initiales (classeurs réels, rapports) : seul le mode d'emploi est versionné.
backend/donnees_initiales/*
!backend/donnees_initiales/LISEZMOI.md

# --- Certificats HTTPS du serveur intranet (clé privée : jamais versionnée) ---
infra/docker/nginx/certs/

# --- Installation sans Docker (deploy/intranet-sans-docker/) : propres à chaque serveur ---
# Réglages et secrets (app/config/.env.production) : déjà couverts par les motifs « .env* » ci-dessus.
venv/
media/
sauvegardes/

# --- Données réelles et sauvegardes : jamais versionnées, nulle part ---
*.xlsx
*.xls
*.dump
*.sql
*.sql.gz
# Script d'initialisation PostGIS du développement Docker (aucune donnée) : versionné.
!infra/docker/postgres/init.sql
