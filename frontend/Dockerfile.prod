# =============================================================================
# frontend/Dockerfile.prod — image de PRODUCTION du frontend React (intranet)
#   1. compilation Vite (Node 22 : exigé par la bibliothèque de cartes) ;
#   2. fichiers compilés servis par Nginx, derrière le Nginx principal (infra/docker/nginx/nginx.prod.conf).
# Les appels à l'API restent relatifs (/api/v1) : même adresse que l'application, aucun CORS.
# =============================================================================

FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
# - /assets/ : fichiers au nom versionné, mis en cache un an ;
# - index.html : jamais en cache, une mise à jour est prise en compte au prochain chargement ;
# - toute autre adresse : index.html (routes React).
RUN printf '%s\n' \
  'server {' \
  '  listen 80;' \
  '  root /usr/share/nginx/html;' \
  '  location /assets/ { expires 1y; add_header Cache-Control "public, immutable"; try_files $uri =404; }' \
  '  location = /index.html { add_header Cache-Control "no-cache"; }' \
  '  location / { add_header Cache-Control "no-cache"; try_files $uri $uri/ /index.html; }' \
  '}' > /etc/nginx/conf.d/default.conf
EXPOSE 80
