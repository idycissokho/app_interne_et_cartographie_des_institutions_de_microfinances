# =============================================================================
# Modèle de config/.env.production — serveur INTRANET (guide : deploy/intranet/README.md)
#
#   cp deploy/intranet/env.production.example config/.env.production
#   chmod 600 config/.env.production
#
# Remplacer chaque valeur entre < >. Ce fichier contient des secrets : il n'est jamais versionné.
# =============================================================================

# --- Django ---
# Clé longue et aléatoire, générée par :  openssl rand -base64 48
DJANGO_SECRET_KEY=<cle-secrete-generee>
# Nom (et/ou adresse IP) par lequel les postes joignent le serveur, séparés par des virgules.
DJANGO_ALLOWED_HOSTS=<carto-imf.intranet.local>
# Même(s) adresse(s), précédée(s) de https:// (connexion à l'administration Django).
DJANGO_CSRF_TRUSTED_ORIGINS=<https://carto-imf.intranet.local>

# --- Base de données (conteneur « db », jamais exposé hors du serveur) ---
DB_NAME=cartographie_imf
DB_USER=cartographie_imf
# Mot de passe robuste, généré par :  openssl rand -base64 24 | tr -d '/+='
DB_PASSWORD=<mot-de-passe-base>
DB_CONN_MAX_AGE=60

# --- HTTPS (Nginx termine le TLS) ---
DJANGO_SECURE_SSL_REDIRECT=true
# HSTS : les navigateurs n'accepteront plus que HTTPS pendant cette durée (secondes).
# Commencer à 3600 (1 h) le temps de valider le certificat, puis passer à 31536000 (1 an).
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
DJANGO_USE_X_FORWARDED_HOST=false

# --- Compte administrateur créé au premier démarrage (jamais modifié ensuite) ---
DJANGO_ADMIN_EMAIL=<admin@finances.gouv.sn>
DJANGO_ADMIN_PASSWORD=<mot-de-passe-administrateur-robuste>
DJANGO_ADMIN_PRENOM=Administrateur
DJANGO_ADMIN_NOM=DRS-SFD

# --- Démarrage du backend ---
MIGRER_AU_DEMARRAGE=true
CHARGER_ZONES_AU_DEMARRAGE=true
# Un seul processus Gunicorn (cache en mémoire cohérent), plusieurs fils pour les requêtes simultanées.
WEB_CONCURRENCY=1
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=120
IMPORT_ASYNCHRONE=true
IMPORT_DELAI_INTERRUPTION=10

# --- Données réelles sur l'intranet : surtout PAS de données fictives ---
DJANGO_DONNEES_FICTIVES=false
# Les justificatifs sont servis par Nginx (deploy/intranet/README.md).
DJANGO_SERVIR_MEDIAS=false

# --- Sessions et sécurité ---
SESSION_INACTIVITE_MINUTES=30
SESSION_DUREE_MAX_HEURES=8
JWT_ACCES_MINUTES=15
LIMITE_CONNEXION=10/min
LIMITE_ASSISTANT=30/min

# --- Itinéraires (facultatif, docs/itineraire.md) ---
# Vide = section Itinéraire indisponible. Avec le service Valhalla interne (profil « itineraire ») :
#   ROUTING_URL=http://valhalla:8002
ROUTING_PROVIDER=valhalla
ROUTING_URL=
ROUTING_TIMEOUT=10

# --- Courriel (facultatif : erreurs serveur envoyées aux administrateurs) ---
# Laisser vide sans serveur de messagerie ; sinon, ex. EMAIL_HOST=smtp.intranet.local
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=noreply@finances.gouv.sn
SERVER_EMAIL=noreply@finances.gouv.sn

# --- Supervision New Relic (facultatif ; vide = désactivé, aucun envoi vers Internet) ---
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=Cartographie IMF (intranet)
