# =============================================================================
# Modèle de config/.env.production — installation SANS DOCKER sur le serveur intranet
# Guide : deploy/intranet-sans-docker/README.md (§ e)
#
# Sur le serveur (deploy_app) :
#   cp deploy/intranet-sans-docker/env.production.example config/.env.production
#   chmod 600 config/.env.production
#
# Remplacer chaque valeur entre < >. Ce fichier contient des secrets : il n'est jamais versionné
# (.gitignore) et n'est jamais touché par la mise à jour (git reset --hard ne supprime pas les
# fichiers ignorés). Il est lu par Gunicorn et par les commandes manage.py via DJANGO_ENV_FILE.
# =============================================================================

# --- Django ---
# Clé longue et aléatoire, générée par :  python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=<cle-secrete-generee>
# Adresse IP et nom par lesquels les postes joignent le serveur (sans le port).
DJANGO_ALLOWED_HOSTS=10.233.225.2,annuaireimf.drs-sfd.gouv.sn
# Mêmes adresses AVEC https:// et le port (connexion à l'administration Django).
# La première sert au contrôle de santé de mettre-a-jour.sh : garder l'IP en tête.
DJANGO_CSRF_TRUSTED_ORIGINS=https://10.233.225.2:8443,https://annuaireimf.drs-sfd.gouv.sn:8443

# --- Base de données (PostgreSQL du serveur, fournie par l'administrateur) ---
DB_NAME=<nom-de-la-base>
DB_USER=<utilisateur-de-la-base>
DB_PASSWORD=<mot-de-passe-de-la-base>
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# --- Fichiers déposés (justificatifs, imports) : hors du code, jamais touchés par une mise à jour ---
DJANGO_MEDIA_ROOT=/var/www/annuairedesimf/media
# Les justificatifs sont servis par Apache (carto-imf.apache.conf), pas par Django.
DJANGO_SERVIR_MEDIAS=false

# --- HTTPS : Apache termine le TLS et transmet X-Forwarded-Proto: https ---
DJANGO_TRUST_X_FORWARDED_PROTO=true
DJANGO_USE_X_FORWARDED_HOST=false
DJANGO_SECURE_SSL_REDIRECT=true
# HSTS désactivé : le serveur héberge d'autres sites en HTTP simple, et l'accès se fait par adresse IP.
# À activer (3600 puis 31536000) seulement avec un nom dédié et un certificat reconnu.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false

# --- Compte administrateur créé à la première installation (jamais modifié ensuite) ---
DJANGO_ADMIN_EMAIL=<admin@finances.gouv.sn>
DJANGO_ADMIN_PASSWORD=<mot-de-passe-administrateur-robuste>
DJANGO_ADMIN_PRENOM=Administrateur
DJANGO_ADMIN_NOM=DRS-SFD

# --- Imports Excel en tâche de fond (Gunicorn : 1 processus, plusieurs fils) ---
IMPORT_ASYNCHRONE=true
IMPORT_DELAI_INTERRUPTION=10

# --- Données réelles sur l'intranet : surtout PAS de données fictives ---
DJANGO_DONNEES_FICTIVES=false

# --- Sessions et sécurité ---
SESSION_INACTIVITE_MINUTES=30
SESSION_DUREE_MAX_HEURES=8
JWT_ACCES_MINUTES=15
JWT_TOLERANCE_SECONDES=10
LIMITE_CONNEXION=10/min
LIMITE_ASSISTANT=30/min
LIMITE_PUBLIC=60/min

# --- Itinéraires : désactivés au départ (guide, § o) ---
ROUTING_PROVIDER=valhalla
ROUTING_URL=
ROUTING_TIMEOUT=10

# --- Courriel (facultatif : erreurs serveur envoyées aux administrateurs) ---
# Laisser vide sans serveur de messagerie.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=noreply@finances.gouv.sn
SERVER_EMAIL=noreply@finances.gouv.sn

# --- Supervision New Relic (facultatif ; vide = désactivé, aucun envoi vers Internet) ---
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=Cartographie IMF (intranet)
