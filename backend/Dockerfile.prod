# =============================================================================
# backend/Dockerfile.prod — image de PRODUCTION du backend Django
#
# Même image pour la démonstration en ligne et pour l'intranet : seules les
# variables d'environnement changent (voir backend/.env.example).
#   - dépendances de production (requirements/production.txt, sans outils de débogage) ;
#   - config.settings.production (DEBUG=False) ;
#   - fichiers statiques collectés à la construction, servis par WhiteNoise ;
#   - démarrage : migrations, compte administrateur, puis Gunicorn sur $PORT.
#
# Le Dockerfile de développement (backend/Dockerfile, runserver) reste celui
# qu'utilise infra/docker-compose.yml.
#
# Construction : docker build -f Dockerfile.prod -t cartographie-imf-backend .
# =============================================================================

FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DJANGO_SETTINGS_MODULE=config.settings.production \
    PORT=8000

# Bibliothèques géospatiales exigées par GeoDjango (GDAL, GEOS, PROJ) et client PostgreSQL.
# Les paquets -dev et gcc ne servent qu'à compiler : ils sont retirés après l'installation.
COPY requirements/ /app/requirements/
RUN apt-get update \
    && apt-get install -y --no-install-recommends gdal-bin libgdal32 libgeos-c1v5 libproj25 libpq5 gcc libpq-dev \
    && pip install -r /app/requirements/production.txt \
    && apt-get purge -y --auto-remove gcc libpq-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . /app/

# Fichiers statiques (admin Django, DRF) : collectés une fois pour toutes dans l'image.
# Valeurs factices : collectstatic ne se connecte pas à la base, mais les réglages exigent ces variables.
RUN DJANGO_SECRET_KEY=construction-uniquement \
    DJANGO_ALLOWED_HOSTS=localhost \
    DATABASE_URL=postgres://construction@localhost/construction \
    python manage.py collectstatic --noinput \
    && chmod +x /app/docker-entrypoint.sh

# Exécution sans privilèges root ; seul le dossier des fichiers déposés est inscriptible.
RUN useradd --system --uid 1000 --home /app django \
    && mkdir -p /app/mediafiles \
    && chown -R django /app/mediafiles
USER django

EXPOSE 8000
ENTRYPOINT ["/app/docker-entrypoint.sh"]
# Gunicorn : nombre de processus réglable par WEB_CONCURRENCY (lu par Gunicorn), 2 par défaut.
# Délai de 120 s : les imports Excel volumineux sont traités pendant la requête.
CMD ["sh", "-c", "exec gunicorn config.wsgi:application --bind 0.0.0.0:${PORT} --workers ${WEB_CONCURRENCY:-2} --threads ${GUNICORN_THREADS:-4} --timeout ${GUNICORN_TIMEOUT:-120} --access-logfile - --error-logfile -"]
