# =============================================================================
# backend/.env.example
# Copier ce fichier en .env et renseigner les valeurs réelles.
# Ne jamais versionner le fichier .env.
# =============================================================================

# --- Django ---
DJANGO_SECRET_KEY=remplacer-par-une-cle-secrete-longue-et-aleatoire
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Base de données PostgreSQL ---
DB_NAME=cartographie_imf
DB_USER=postgres
DB_PASSWORD=remplacer-par-le-mot-de-passe
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# --- CORS et CSRF (renseigner les domaines réels en production) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Reverse proxy HTTPS (production uniquement) ---
# Activer uniquement si le proxy de confiance remplace X-Forwarded-Proto.
DJANGO_TRUST_X_FORWARDED_PROTO=false
DJANGO_USE_X_FORWARDED_HOST=false
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false

# --- Email (production) ---
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=noreply@example.com
SERVER_EMAIL=noreply@example.com
