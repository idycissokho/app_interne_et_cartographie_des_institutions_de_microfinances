                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/profil/",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nom\": \"Diallo\",\n  \"prenom\": \"Amadou\"\n}"
            }
